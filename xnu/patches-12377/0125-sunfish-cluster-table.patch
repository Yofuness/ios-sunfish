From cf7e506acb38bb8a0ecf69b9614a8d8c4f816dc7 Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Fri, 13 Nov 2026 07:43:12 -0500
Subject: [PATCH] 0125 sunfish: cpufreq cluster table A55 x6 / A76 x2 (SM7150)

IOS-26-Hot's 0086 keeps flame's SM8150 table (A55 x4 / A76 x3 / A76 prime at 0x18327800);
sunfish has two OSM clusters. Same lines as our xnu/patches/0086-flame-cpufreq.patch (kept
byte-identical, no comment, so our later cpufreq patches 0255-0276 see the same context).
---
 bsd/dev/sweet_cpufreq.c | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
index 82097a3..23f7ffd 100644
--- a/bsd/dev/sweet_cpufreq.c
+++ b/bsd/dev/sweet_cpufreq.c
@@ -27,9 +27,8 @@ static const struct {
 	const char *name;
 	uint32_t pa;
 } osm_clusters[] = {
-	{"pwrcl (A55 x4)", 0x18323000u},
-	{"perfcl (A76 x3)", 0x18325800u},
-	{"perfpcl (A76 prime)", 0x18327800u},
+	{"pwrcl (A55 x6)", 0x18323000u},
+	{"perfcl (A76 x2)", 0x18325800u},
 };
 
 static uint32_t
-- 
2.56.0

