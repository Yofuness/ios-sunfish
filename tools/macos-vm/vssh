#!/bin/sh
# ssh into the macOS build VM (start it with mac-vm.sh first)
# VM data (disk, state, keys, credentials) lives outside git, in $VM_DIR (or $MACOS_VM_DIR; default ~/VMs/macos)
D=${VM_DIR:-${MACOS_VM_DIR:-$HOME/VMs/macos}}
exec ssh -o UserKnownHostsFile="$D/known_hosts" -o ServerAliveInterval=30 -i "$D/id_ed25519" -p "${VM_SSH_PORT:-2222}" builder@127.0.0.1 "$@"
