+static inline void
+tu_cs_fail(struct tu_cs *cs, VkResult result)
+{
+   if (!tu_sweet_cs_fail_sink_on())
+      return;
+   cs->status = result;
+   cs->cur = tu_cs_fail_sink;
+   cs->reserved_end = tu_cs_fail_sink + ARRAY_SIZE(tu_cs_fail_sink);
