From 5a7962e3dd7d567fbdadf2b6ca2ea37eed501b36 Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Tue, 3 Nov 2026 15:17:42 -0500
Subject: [PATCH] sunfish: RPMh timeouts that end idle with fresh completion
 count as done, quarantine per TCS, real 100 ms deadline, 50 ms lock wait
 instead of EBUSY; sweetrpmhfix=0 turns it off (0279)

---
 bsd/dev/sweet_rpmh.c | 136 ++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 122 insertions(+), 14 deletions(-)

diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
index 7c05343..111e46e 100644
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -2,15 +2,21 @@
  * SWEET PM6150L L11C bring-up; see report.md for DT and source evidence.
  * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
  * No sleep/wake programming, SPMI writes, GIC handler, or timeout recovery.
+ * 0279 (boot-arg sweetrpmhfix, default 1; 0 = the old behaviour): a timeout that ends idle with fresh
+ * completion in CMD_STATUS counts as done, quarantine is per TCS, the timeout is real time, and a busy
+ * lock is waited on up to 50 ms. Nothing new is written to the hardware.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <sys/errno.h>
 #include <kern/clock.h>
+#include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern int get_preemption_level(void);
 int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
 
 /* Live downstream DT has two positional reg entries, no reg-names. */
@@ -47,12 +53,70 @@ int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
 #define RH_ARC          3u
 #define RH_BCM          5u
 #define RH_TIMEOUT_US   100000u
+#define RH_LOCK_WAIT_MS 50u      /* 0279 */
+#define RH_POISON_ALL   (1u << 31) /* 0279: shared IRQ_EN uncertain, every TCS */
 
 static vm_offset_t rh_rsc, rh_tcs, rh_dict, rh_db;
 static uint32_t rh_db_size;
 static unsigned rh_ncpt;
 static unsigned rh_lock;
-static bool rh_poisoned;
+static uint32_t rh_poisoned;     /* 0279: bit t = TCS t quarantined; RH_POISON_ALL = all */
+static int rh_fix = -1;
+
+/* 0279: boot-arg sweetrpmhfix (default 1); 0 = one global quarantine, loop-count timeout, try-lock only. */
+static bool
+rh_fix_on(void)
+{
+	if (rh_fix < 0) {
+		uint32_t v = 1;
+		PE_parse_boot_argn("sweetrpmhfix", &v, sizeof(v));
+		rh_fix = v != 0;
+	}
+	return rh_fix;
+}
+
+/* Old mode: any quarantine refuses all. 0279: only when no ACTIVE TCS is left. */
+static bool
+rh_refused(void)
+{
+	if (!rh_fix_on()) {
+		return rh_poisoned != 0;
+	}
+	return (rh_poisoned & RH_POISON_ALL) ||
+	       (rh_poisoned & ((1u << RH_ACTIVE_N) - 1u)) == (1u << RH_ACTIVE_N) - 1u;
+}
+
+/*
+ * 0279: a concurrent voter used to get EBUSY at once. All callers run in thread context (pmem ioctl,
+ * the touch/FTS threads, gpu_thread's gpu_bus_vote), so wait for the lock in 1 ms sleeps up to 50 ms;
+ * a caller that cannot sleep keeps the plain try-lock.
+ */
+static bool
+rh_acquire(void)
+{
+	if (!__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return true;
+	}
+	if (!rh_fix_on() || !ml_get_interrupts_enabled() || ml_at_interrupt_context() ||
+	    get_preemption_level() != 0) {
+		return false;
+	}
+	static int rh_lock_chan;
+	uint64_t t0 = mach_absolute_time(), limit, deadline, ns;
+	nanoseconds_to_absolutetime(RH_LOCK_WAIT_MS * NSEC_PER_MSEC, &limit);
+	do {
+		clock_interval_to_deadline(1, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&rh_lock_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		if (!__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+			printf("SWEET RPMH: waited %llu us for a concurrent vote\n", ns / 1000);
+			return true;
+		}
+	} while (mach_absolute_time() - t0 < limit);
+	printf("SWEET RPMH: lock busy for %u ms; EBUSY\n", RH_LOCK_WAIT_MS);
+	return false;
+}
 
 static uint32_t
 rh_read(vm_offset_t base, uint32_t off)
@@ -240,7 +304,7 @@ rh_send_cmds(uint32_t address, unsigned n, const uint32_t *offsets, const uint32
 				return EBUSY;
 			}
 		}
-		if (chosen < 0 && rh_free(t)) {
+		if (chosen < 0 && !(rh_poisoned & (1u << t)) && rh_free(t)) {
 			chosen = (int)t;
 		}
 	}
@@ -256,18 +320,19 @@ rh_send_cmds(uint32_t address, unsigned n, const uint32_t *offsets, const uint32
 	}
 	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
 	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
-		rh_poisoned = true;
+		rh_poisoned |= RH_POISON_ALL;
 		return EIO;
 	}
 	if (!rh_free(t)) {
 		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
 		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
-			rh_poisoned = true;
+			rh_poisoned |= RH_POISON_ALL;
 		}
 		return EBUSY;
 	}
 	/* From here an uncertain write/timeout quarantines our slot for this boot. */
-	rh_poisoned = true;
+	rh_poisoned |= bit;
+	bool fix = rh_fix_on();
 	uint32_t mask = (1u << n) - 1u;
 	printf("SWEET RPMH: TCS%u ACTIVE %u commands at %#x (first %#x=%u) irq-enable=%#x\n", t, n, address,
 	    offsets[0], values[0], irq_en);
@@ -283,13 +348,29 @@ rh_send_cmds(uint32_t address, unsigned n, const uint32_t *offsets, const uint32
 	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
 		return EIO;
 	}
+	/* 0279: CMD_STATUS just before the trigger, to tell fresh completion from stale (reads only). */
+	uint32_t pre[4] = {0, 0, 0, 0};
+	if (fix) {
+		for (unsigned c = 0; c < n; ++c) {
+			pre[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+		}
+	}
+	uint64_t t_trig = mach_absolute_time(), t_first = 0, deadline;
+	nanoseconds_to_absolutetime((uint64_t)RH_TIMEOUT_US * NSEC_PER_USEC, &deadline);
+	deadline += t_trig;
 	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
 	uint32_t irq = 0, idle = 0, status[4] = {0, 0, 0, 0};
-	bool done = false, progress = false;
-	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+	bool done = false, progress = false, complete = false;
+	unsigned polls = 0;
+	/* 0279: delay(1) costs ~24 us, so the loop count made "100 ms" last 2.4-3.3 s; use a real deadline. */
+	for (unsigned us = 0; fix || us < RH_TIMEOUT_US; ++us) {
+		if (!t_first) {
+			t_first = mach_absolute_time();
+		}
+		++polls;
 		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
 		idle = rh_read(rh_tcs, b + RH_STATUS);
-		bool complete = true;
+		complete = true;
 		for (unsigned c = 0; c < n; ++c) {
 			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
 			complete &= status[c] != 0xffffffffu &&
@@ -302,12 +383,35 @@ rh_send_cmds(uint32_t address, unsigned n, const uint32_t *offsets, const uint32
 			done = true;
 			break;
 		}
+		if (fix && mach_absolute_time() >= deadline) {
+			break;
+		}
 		delay(1);
 	}
 	printf("SWEET RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
 	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	if (!done && fix) {
+		uint64_t first_ns, total_ns;
+		absolutetime_to_nanoseconds(t_first - t_trig, &first_ns);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t_trig, &total_ns);
+		bool fresh = true;
+		for (unsigned c = 0; c < n; ++c) {
+			fresh &= pre[c] != 0xffffffffu && !(pre[c] & RH_COMPLETE);
+		}
+		printf("SWEET RPMH: TCS%u timeout after %llu us, %u polls, trigger->first poll %llu us; "
+		    "pre-trigger cmd-status=%#x/%#x/%#x/%#x, at timeout cmd-status[3]=%#x complete=%d fresh=%d\n",
+		    t, total_ns / 1000, polls, first_ns / 1000, pre[0], pre[1], pre[2], pre[3], status[3],
+		    complete, fresh);
+		/* 0279: idle with fresh completion of every command is a success we failed to watch happen. */
+		if (idle == 1u && irq != 0xffffffffu && complete && fresh) {
+			printf("SWEET RPMH: TCS%u completion unobserved (idle, all %u commands complete); "
+			    "treating as done\n", t, n);
+			done = true;
+		}
+	}
 	if (!done) {
-		printf("SWEET RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		printf("SWEET RPMH: timeout; TCS%s quarantined, IRQ remains masked; no reset/retry\n",
+		    fix ? (t ? "1" : "0") : "");
 		return ETIMEDOUT;
 	}
 	/* Proven completion: clear trigger before mode, then free only our commands. */
@@ -320,7 +424,11 @@ rh_send_cmds(uint32_t address, unsigned n, const uint32_t *offsets, const uint32
 	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
 		return EIO;
 	}
-	rh_poisoned = false;
+	if (fix) {
+		rh_poisoned &= ~bit;    /* 0279: other TCS keep their state */
+	} else {
+		rh_poisoned = 0;
+	}
 	printf("SWEET RPMH: ACTIVE vote complete (rail voltage requires hardware verification)\n");
 	return 0;
 }
@@ -347,12 +455,12 @@ sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uin
 	if (!res || n == 0 || n > 4) {
 		return EINVAL;
 	}
-	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+	if (!rh_acquire()) {
 		return EBUSY;
 	}
 	int error = EIO;
 	uint32_t address = 0;
-	if (!rh_poisoned) {
+	if (!rh_refused()) {
 		error = rh_map();
 		if (!error) {
 			error = rh_lookup(res, &address);
@@ -377,12 +485,12 @@ sweet_rpmh_vreg_enable(const char *res, unsigned mv)
 		printf("SWEET RPMH: %s %u mV is not an allowed touch rail\n", res ? res : "?", mv);
 		return EINVAL;
 	}
-	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+	if (!rh_acquire()) {
 		return EBUSY;
 	}
 	int error = EIO;
 	uint32_t address = 0;
-	if (rh_poisoned) {
+	if (rh_refused()) {
 		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
 		goto out;
 	}
-- 
2.56.0

