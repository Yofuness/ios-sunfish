From ca24d74c66c9bb7ea9f317b6150e03cc7760b766 Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Thu, 12 Nov 2026 21:05:23 -0500
Subject: [PATCH] sunfish: isb between AT and PAR_EL1 read in
 mmu_kvtop_wpreflight (UniXNU f65660d)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 osfmk/arm64/machine_routines_asm.s | 1 +
 1 file changed, 1 insertion(+)

diff --git a/osfmk/arm64/machine_routines_asm.s b/osfmk/arm64/machine_routines_asm.s
index 2449334..4a077b6 100644
--- a/osfmk/arm64/machine_routines_asm.s
+++ b/osfmk/arm64/machine_routines_asm.s
@@ -427,6 +427,7 @@ LEXT(mmu_kvtop_wpreflight)
 	mrs		x2, DAIF									// Load current DAIF
 	msr		DAIFSet, #(DAIFSC_IRQF | DAIFSC_FIQF)		// Disable IRQ
 	at		s1e1w, x0									// Translation Stage 1 EL1
+	isb		sy											// sunfish 0281: PAR_EL1 valid only after a context sync, as in mmu_kvtop (UniXNU f65660d)
 	mrs		x1, PAR_EL1									// Read result
 	msr		DAIF, x2									// Restore interrupt state
 	tbnz	x1, #0, L_mmu_kvtop_wpreflight_invalid		// Test Translation not valid
-- 
2.56.0

